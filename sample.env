# SQLAlchemy async DSN for the Envoy PostgreSQL database
ENVOY_DB_DSN=postgresql+asyncpg://user:pass@localhost:8003/envoy_db

# Required by Envoy's model layer at import time — use the same value as ENVOY_DB_DSN
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:8003/envoy_db

# NMI validation — required for S-OPT-02 to reject invalid connection point IDs
# Must be a valid DNSPParticipantId enum value (see envoy/server/manager/nmi_validator.py)
NMI_VALIDATION_ENABLED=true
NMI_VALIDATION_PARTICIPANT_ID=ENERGYAP
