# SQLAlchemy async DSN for the Envoy PostgreSQL database
ENVOY_DB_DSN=postgresql+asyncpg://test_user:test_pwd@localhost:8003/test_db

# Required by Envoy's model layer at import time — use the same value as ENVOY_DB_DSN
DATABASE_URL=postgresql+asyncpg://test_user:test_pwd@localhost:8003/test_db

# Base URL of the envoy-admin service. Username/password match the demo compose defaults.
ENVOY_ADMIN_URI=http://localhost:8001
